[Unit]
Description=Hello World Orders Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=hello-orders
Group=hello-orders
WorkingDirectory=/opt/hello-services/orders-service
ExecStart=/usr/bin/java -Xms32m -Xmx192m -jar /opt/hello-services/orders-service/current.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
