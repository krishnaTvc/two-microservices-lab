[Unit]
Description=Hello World Users Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=hello-users
Group=hello-users
WorkingDirectory=/opt/hello-services/users-service
ExecStart=/usr/bin/java -Xms32m -Xmx192m -jar /opt/hello-services/users-service/current.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
